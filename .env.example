# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES=7d

# ── XUMM (Xaman) wallet signing ───────────────────────────────────────────────
# Get API credentials at https://apps.xumm.dev
XUMM_API_KEY=your_xumm_api_key_here
XUMM_API_SECRET=your_xumm_api_secret_here

# ── XRPL Network ─────────────────────────────────────────────────────────────
# testnet | mainnet
XRPL_NETWORK=testnet
# Single node or comma-separated list for automatic failover
XRPL_NODES=wss://s.altnet.rippletest.net:51233,wss://s2.altnet.rippletest.net:51233
# Legacy single-node fallback (still supported)
# XRPL_NODE=wss://s.altnet.rippletest.net:51233

# ── Server wallet (testnet demos / /settle endpoint only) ─────────────────────
# Never commit a real mainnet seed
XRPL_WALLET_SEED=your_testnet_seed_here
XRPL_DESTINATION_ADDRESS=your_testnet_address_here

# ── RLUSD Issuer (testnet) ────────────────────────────────────────────────────
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get a free API key at https://resend.com — 3,000 emails/month free
# If not set, email notifications are logged to console only
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=TradeFlow <noreply@yourdomain.com>

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to data/tradeflow.db — override for custom path
# DB_PATH=/var/data/tradeflow.db

# ── Compliance (Phase 4) ──────────────────────────────────────────────────────
# USD threshold above which KYC must be verified (Travel Rule)
TRAVEL_RULE_THRESHOLD=1000

# ── Feature flags (Phase 4) ───────────────────────────────────────────────────
# Set to true to use MPTokenIssuanceCreate instead of NFTokenMint (requires MPToken amendment on-ledger)
# ENABLE_MPT=false
